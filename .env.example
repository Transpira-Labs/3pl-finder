# Database (set automatically by Docker Compose)
DATABASE_URL=postgres://sales:sales@localhost:5433/sales_automation

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Google Maps (required for store discovery)
GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Twilio (optional — for browser calling)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

# SalesHandy (optional — for lead import)
SALESHANDY_API_KEY=

# Email follow-ups (optional)
RESEND_API_KEY=
FROM_EMAIL=
REPLY_TO_EMAIL=
MAILING_ADDRESS=

# AI SMS drafting (optional)
ANTHROPIC_API_KEY=

# Google Sheets export (optional)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Store enrichment (optional — enhances discovery)
OPENSOSDATA_API_KEY=
OPENMART_API_KEY=

# App URL (for Twilio webhooks — use ngrok/cloudflare tunnel URL if local)
PUBLIC_URL=http://localhost:3000
